.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Tests and runtime adapters stay local and are not published.
tests/
**/tests/
photo-cull/scripts/make_test_set.py
photo-repair/scripts/make_test_image.py
agents/
**/agents/

# Internal verification records are not part of the public examples.
**/examples/**/verification.json
**/examples/**/run-result.json

# Publish independent skill folders; shared working material stays local.
/example-assets/
/AUDIT.md
/GALLERY.md
/PORTABILITY.md
/README.md

# Local runtime configuration, secrets, and test runner artifacts.
.codex/
.openai/
.claude/
.agents/
.cursor/
.env
.env.*
!.env.example
.cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.log
*.tmp
*.swp

# High-bit intermediates are used for local gallery checks; PNG previews are published.
**/examples/output/*.tif
**/examples/output/*.tiff
**/examples/cases/*/output/*.tif
**/examples/cases/*/output/*.tiff

# Local session and generated root artifacts
/:memory:.ses
/standard-pdf-template.pdf

# Local environments and editor state
.venv/
venv/
.idea/
.vscode/
